# ─── Global ────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=wunzi
WUNZI_MODE=fixture            # live | fixture  (fixture = cached authentic provider outputs)
DATASET_VERSION=dataset-v1
PIPELINE_VERSION=pipeline-v1

# ─── Laravel (apps/api) ────────────────────────────────────────────────────
APP_NAME=WUNZI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wunzi
DB_USERNAME=wunzi
DB_PASSWORD=wunzi

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=wunzi
AWS_SECRET_ACCESS_KEY=wunzi-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=wunzi-audio
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Laravel → FastAPI
INTELLIGENCE_BASE_URL=http://intelligence:8001
INTERNAL_AI_SERVICE_SECRET=change-me-internal-shared-secret
# The timeout budget lives in one place, further down. It was duplicated here
# with a stale value of 120 — and phpdotenv keeps the FIRST definition, so that
# stale value would have won and put Laravel below FastAPI's 240s worst case.

# ─── FastAPI (apps/intelligence) ───────────────────────────────────────────
INTELLIGENCE_HOST=0.0.0.0
INTELLIGENCE_PORT=8001
INTELLIGENCE_LOG_LEVEL=info

# ASR providers
DEFAULT_ASR_PROVIDER=sahara
SAHARA_API_KEY=
SAHARA_BASE_URL=https://api.intron.ai/sahara/v2.5
SAHARA_MODEL=sahara-2.5-trilingual
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-large-v3
MODEL_B_API_KEY=
MODEL_B_BASE_URL=
MODEL_B_MODEL=gemini-speech
MODEL_C_API_KEY=
MODEL_C_BASE_URL=
MODEL_C_MODEL=nemotron-asr

# LLM (claim extraction / semantic comparison)
LLM_PROVIDER=deterministic     # deterministic | anthropic | openai
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Critical Speech Guard thresholds
GUARD_AMOUNT_CONFIDENCE_THRESHOLD=0.90
GUARD_DATE_CONFIDENCE_THRESHOLD=0.85
GUARD_DEFAULT_CONFIDENCE_THRESHOLD=0.80

# Storage (shared with Laravel)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=wunzi-audio
S3_ACCESS_KEY=wunzi
S3_SECRET_KEY=wunzi-secret

FIXTURE_ROOT=/benchmark/fixtures
BENCHMARK_ROOT=/benchmark

# ── Web (Next.js) ──────────────────────────────────────────────────────────
# Server-side only. The browser never receives these.
LARAVEL_API_URL=http://api:8000
# Mint with `php artisan wunzi:token`. Required: nearly every /api route is
# behind auth:sanctum.
WUNZI_API_TOKEN=

NEXT_PUBLIC_APP_NAME=WUNZI
NEXT_PUBLIC_DEMO_MODE=true

# ── Timeout budget ─────────────────────────────────────────────────────────
# These must nest: ASR call < FastAPI handler < INTELLIGENCE_TIMEOUT < job
# timeout. An outer layer tighter than an inner one discards work already paid
# for. See docs/service-contract.md.
INTELLIGENCE_TIMEOUT=300
INTELLIGENCE_CONNECT_TIMEOUT=5
ASR_TIMEOUT_SECONDS=120
ASR_MAX_RETRIES=1
BENCHMARK_MAX_WAIT_SECONDS=3300
