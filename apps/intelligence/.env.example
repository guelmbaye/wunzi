# WUNZI intelligence service — local configuration
#
#   cp .env.example .env
#
# Only needed when running this service on its own:
#
#   uvicorn app.main:app --reload --port 8001
#   python -m app.benchmark.cli run --split dev
#   pytest
#
# Under docker compose this file is ignored: the stack injects the ROOT
# .env instead (`env_file: [.env]`), so the two must not drift. Anything added
# here belongs in the root .env.example too.
#
# `app/config.py` is the source of truth for every key below. A name that does
# not match a field on `Settings` is silently discarded (`extra="ignore"`).

# ── Runtime ─────────────────────────────────────────────────────────────────
# fixture replays stored provider output; live calls the real ASR APIs.
WUNZI_MODE=fixture

# Bumping the pipeline version invalidates transcription idempotency keys on the
# Laravel side, which is how a pipeline change gets re-measured instead of
# quietly inheriting old results.
PIPELINE_VERSION=pipeline-v1
DATASET_VERSION=dataset-v1

# Must match INTERNAL_AI_SERVICE_SECRET on the Laravel side. Every /v1 route
# rejects a request without it.
INTERNAL_AI_SERVICE_SECRET=change-me-internal-shared-secret

INTELLIGENCE_LOG_LEVEL=info

# ── Paths ───────────────────────────────────────────────────────────────────
# The defaults in config.py are CONTAINER paths (/benchmark). Running on a host
# they point at nothing, so the fixture provider finds no cached output and the
# benchmark finds no manifest. These are the repo-relative equivalents.
FIXTURE_ROOT=../../benchmark/fixtures
BENCHMARK_ROOT=../../benchmark

# ── ASR providers ───────────────────────────────────────────────────────────
# Keys are only read in live mode. A provider without a key is refused rather
# than silently swapped for another one — substitution would corrupt the
# benchmark and falsify a case's provenance.
DEFAULT_ASR_PROVIDER=sahara

SAHARA_API_KEY=
SAHARA_BASE_URL=https://api.intron.ai/sahara/v2.5
SAHARA_MODEL=sahara-2.5-trilingual

WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.openai.com/v1
WHISPER_MODEL=whisper-large-v3

MODEL_B_API_KEY=
MODEL_B_BASE_URL=
MODEL_B_MODEL=model_b

MODEL_C_API_KEY=
MODEL_C_BASE_URL=
MODEL_C_MODEL=model_c

# Retries live in this service and nowhere else. Laravel does not retry
# transcription: two layers of three attempts is nine ASR calls per recording,
# and with the queue job's own tries, twenty-seven. Worst case here is
# ASR_TIMEOUT_SECONDS x (1 + ASR_MAX_RETRIES) = 240s, which must stay below
# INTELLIGENCE_TIMEOUT on the Laravel side. See docs/service-contract.md.
ASR_TIMEOUT_SECONDS=120
ASR_MAX_RETRIES=1

# ── LLM ─────────────────────────────────────────────────────────────────────
# deterministic is the default and needs no network: rules and lexicons only,
# fully inspectable. Semantic comparison then degrades to UNCERTAIN rather than
# guessing, which surfaces as UNVERIFIED — a valid, visible state in WUNZI.
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_BASE_URL=https://api.anthropic.com/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# ── Critical Speech Guard ───────────────────────────────────────────────────
# Below these, a critical value is sent back to the speaker for confirmation
# instead of entering the case unflagged. Amounts are strictest: a misheard
# amount is the failure with the highest cost in a deposit dispute.
GUARD_AMOUNT_CONFIDENCE_THRESHOLD=0.90
GUARD_DATE_CONFIDENCE_THRESHOLD=0.85
GUARD_DEFAULT_CONFIDENCE_THRESHOLD=0.80

# ── Storage ─────────────────────────────────────────────────────────────────
# Audio is read directly from private object storage by this service; Laravel
# sends a URI, never bytes. Unused in fixture mode.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wunzi-audio
S3_ACCESS_KEY=
S3_SECRET_KEY=
