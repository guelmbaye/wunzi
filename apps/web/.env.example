# apps/web/.env.local
#
#   cp .env.example .env.local
#
# Server-side only. The browser never receives these: every read runs in a
# Server Component and every write through a Server Action.

# Where Laravel is listening.
#
#   running `npm run dev` on your machine   -> http://localhost:8000
#   running under docker compose            -> http://api:8000  (set by compose)
#
# `api` is a compose service name. It does NOT resolve on a host, which is the
# usual cause of "the API is not reachable" during local development.
LARAVEL_API_URL=http://localhost:8000

# Every /api route except /health, /responsible-ai and /auth/login sits behind
# auth:sanctum, so without a token the workspace gets 401 on everything.
#
# Mint one:
#
#   cd apps/api
#   php artisan db:seed          # creates mediator@wunzi.demo
#   php artisan wunzi:token      # prints the value to paste below
#
# Sanctum stores only a hash, so the plaintext is shown once. Re-run with
# --revoke to replace it.
WUNZI_API_TOKEN=

# Public. Safe to ship to the browser.
NEXT_PUBLIC_APP_NAME=WUNZI
NEXT_PUBLIC_DEMO_MODE=true
